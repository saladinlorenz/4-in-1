# AgentOS configuration (phase 2: workflows, confirmations, scheduler)
# Copy to .env and fill in real values. Never commit .env.

# LLM endpoints, tried in order with automatic fallback.
# freellmapi gateway (phase 1 adapter target):
LLM_ENDPOINTS=[{"base_url":"http://127.0.0.1:3001/v1","api_key":"freellmapi-CHANGE_ME","model":"auto","timeout":60}]

# Example with a direct free provider as second endpoint:
# LLM_ENDPOINTS=[{"base_url":"http://127.0.0.1:3001/v1","api_key":"freellmapi-CHANGE_ME","model":"auto"},{"base_url":"https://generativelanguage.googleapis.com/v1beta/openai/","api_key":"GEMINI_KEY","model":"gemini-2.5-flash"}]

LLM_MAX_ATTEMPTS=2
LLM_BACKOFF_BASE=1.5
LLM_COOLDOWN_SECONDS=30
LLM_TOOL_CHOICE=required

AGENT_MAX_STEPS=12
AGENT_MAX_OUTPUT_CHARS=4000

# Workflows: retries applied to a failing step before the run fails.
WORKFLOW_RETRY_LIMIT=1
WORKFLOW_RETRY_BACKOFF_BASE=1.5

# Scheduler (cron triggers only; execution stays in SQLite + AgentRunner).
SCHEDULER_ENABLED=true
# IANA timezone used for the cron jobs, e.g. Europe/Paris.
SCHEDULER_TIMEZONE=UTC
# Confirmations older than this are expired automatically (hours).
CONFIRMATION_TTL_HOURS=24
# Tasks RUNNING longer than this are reported by the supervisor (hours).
STUCK_TASK_HOURS=2

# Telegram (create a bot with @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Comma separated Telegram user IDs allowed to command the agent (required).
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_SEND_TIMEOUT=30

# Local health endpoint (bind to 127.0.0.1 only unless LAN access is needed)
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8080

LOG_LEVEL=INFO
